# === Required: Supabase for cloud persistence ===
# Get these from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# === Required: Admin authentication ===
NEXT_PUBLIC_ADMIN_EMAIL=
ADMIN_EMAIL=
# Server-only password (do NOT use NEXT_PUBLIC_ADMIN_PASSWORD in production)
ADMIN_PASSWORD=

# === LLM provider for Stock Pulse AI narratives, multibagger deep analysis, news AI ===
# Priority: GEMINI_API_KEY → DEEPSEEK_API_KEY → LLM_API_KEY (Groq) → OPENAI_API_KEY
#
# RECOMMENDED: Google Gemini (AI Studio) — generous FREE tier, gemini-2.0-flash
# 1. https://aistudio.google.com → Get API key
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash   (or gemini-1.5-pro for deeper analysis)
#
# Fallback: DeepSeek (very cheap paid-per-token)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
#
# Fallback: Groq (free, fast Llama)
# LLM_API_KEY=gsk_...
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=llama-3.3-70b-versatile
#
# Fallback: OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# === Annual AI intelligence report (email) ===
# Recipient (defaults to zn4.editz@gmail.com if unset)
ANNUAL_REPORT_EMAIL=zn4.editz@gmail.com
# Protect send endpoint in production (header: x-report-secret)
ANNUAL_REPORT_SECRET=your-long-random-secret
# Auto-send: full Indian FY report every 1 April (IST); set false to disable
ANNUAL_REPORT_AUTO=true
ANNUAL_REPORT_FY_AUTO=true
# Optional: monthly summary on last day of month
# ANNUAL_REPORT_MONTHLY=true

# Gmail SMTP (recommended) — create App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Or generic SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Alternative: Resend (https://resend.com)
# RESEND_API_KEY=
# RESEND_FROM=Quantum Alpha <reports@yourdomain.com>

# === Deployment ===
# Set RENDER=true on Render platform to enable the 24/7 background engine
RENDER=true
# On Render free tier, bandwidth saver auto-enables (slower polls, no SSE, lite quotes).
# Set false to force full-speed polling even on Render.
# RENDER_BANDWIDTH_SAVER=true
NEXT_PUBLIC_DEMO_MODE=false

# Note: If Supabase keys are not set, the app runs entirely in localStorage mode
# (all data persists only in the browser). Set them to enable cloud sync.
